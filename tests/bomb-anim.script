run 30                                              # let startup finish on the title screen
press space                                         # press Space to start a game
run 1                                               # one frame to register the press
release space                                       # let go of Space
run 2                                               # let the first frame of play run
poke bomb_active 1 0 0                              # one bomb in flight, well above the ship
poke bomb_u 100 0 0                                 # in the middle of the field
poke bomb_y 60 0 0                                  # clear of the aliens' shield-free zone
peek bomb_frame 0                                   # the bombs start on frame A
wait bomb_frame 1 100                               # the next bomb step switches to frame B
wait bomb_frame 0 100                               # and the step after switches back to frame A
