run 30                                              # let startup finish on the title screen
press space                                         # press Space to start a game
run 1                                               # one frame to register the press
release space                                       # let go of Space
run 2                                               # let the first frame of play run
poke bomb_active 1                                  # put a bomb in slot 0
poke bomb_u 76                                      # directly above the ship (ship x = 76)
poke bomb_y 172                                     # two steps above the ship's top row (188)
run 20                                              # two bomb steps: the bomb hits the ship
peek lives 2                                        # one ship was lost
peek player_dead 1                                  # the game is paused
peek bomb_active 0                                  # the bomb is gone
run 110                                             # still inside the 120-frame pause
peek player_dead 1                                  # still paused
run 20                                              # the pause ends
peek player_dead 0                                  # the ship is back
peek player_u 76                                    # at its starting position
