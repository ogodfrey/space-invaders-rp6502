run 30                                              # let startup finish on the title screen
expect console "SPACE INVADERS"                     # the title is printed
press space                                         # press Space to start a game
run 1                                               # one frame to register the press
release space                                       # let go of Space
run 2                                               # let the first frame of play run
expect console "A/D or arrows move"                 # the control hint is printed for the game
peek player_u 76                                    # ship starts at the center of the field (x = 76)
press right                                         # hold the right arrow
run 1                                               # one frame: one step
peek player_u 78                                    # ship moved 2 units (4 px)
release right                                       # let go of the arrow
press space                                         # press Space to fire
run 2                                               # let the bullet start
peek bullet_active 1                                # a bullet is in flight
release space                                       # let go of Space
